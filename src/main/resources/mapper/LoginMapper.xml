<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.eams.mapper.LoginMapper">
    <insert id="registerUser" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (usercode, password, role)
        VALUES (#{usercode}, #{password}, #{role})
    </insert>

    <select id="selectByUsercode" resultType="com.example.eams.entity.User">
        SELECT * FROM sys_user WHERE usercode = #{usercode}
    </select>
</mapper>